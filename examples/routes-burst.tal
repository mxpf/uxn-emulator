( Local route 01 carries bytes 01..05; route 02 carries aa independently.
  ZP: 00 next byte, 01 wakes, 02 failures, 03 done, 04 notified selector. )
|0100
	;on-writable #da DEO2
	#01 #dc DEO
	#0400 #d6 DEO2
	#01 #d8 DEO
	#01 #00 STZ
	!send

@send
	#00 LDZ #0400 STA
	#01 #d9 DEO
	#d9 DEI ?accepted
	#02 LDZ INC #02 STZ
	( Keep 05 at 0400, then prove another route can still send. )
	#aa #0401 STA
	#0401 #d6 DEO2
	#02 #dc DEO
	#01 #d9 DEO
	BRK

@accepted
	#00 LDZ INC DUP #00 STZ
	#06 NEQ ?send
	#01 #03 STZ
	BRK

@on-writable
	#01 LDZ INC #01 STZ
	#de DEI DUP #04 STZ #dc DEO
	#0400 #d6 DEO2
	!send
