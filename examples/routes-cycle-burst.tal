( Repeat 1024 batches, waiting for a collector acknowledgement each time.
  ZP: 00 next byte, 01 wakes, 02 full sends, 03 batch sent,
  04 notified route, 06-07 batch count, 08 stopped. )
|0100
	;on-ack #d0 DEO2
	#0300 #d2 DEO2
	;on-writable #da DEO2
	#01 #d8 DEO
	!start-batch

@on-ack
	!start-batch

@start-batch
	#06 LDZ2 #0400 EQU2 ?done
	#06 LDZ2 INC2 #06 STZ2
	#01 #00 STZ
	#00 #03 STZ
	#01 #dc DEO
	#0400 #d6 DEO2
	!send

@send
	#00 LDZ #0400 STA
	#01 #d9 DEO
	#d9 DEI ?accepted
	#02 LDZ INC #02 STZ
	#aa #0401 STA
	#0401 #d6 DEO2
	#02 #dc DEO
	#01 #d9 DEO
	BRK

@accepted
	#00 LDZ INC DUP #00 STZ
	#06 NEQ ?send
	#01 #03 STZ
	BRK

@on-writable
	#01 LDZ INC #01 STZ
	#de DEI DUP #04 STZ #dc DEO
	#0400 #d6 DEO2
	!send

@done
	#01 #08 STZ
	BRK
