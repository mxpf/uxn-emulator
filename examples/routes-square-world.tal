( Demo world: a clamped 16 by 12 board; ZP 00 x, 01 y, 02 error. )
|0100
	;receive #d0 DEO2 #0300 #d2 DEO2
	#0400 #d6 DEO2 #02 #d8 DEO #01 #dc DEO
	#08 #00 STZ #06 #01 STZ
	!publish
@receive
	#dd DEI #00 NEQ ?done
	#d4 DEI #01 NEQ ?done
	#0300 LDA #01 EQU ?north
	#0300 LDA #02 EQU ?east
	#0300 LDA #03 EQU ?south
	#0300 LDA #04 EQU ?west
	BRK
@north #01 LDZ #00 EQU ?publish #01 LDZ #01 SUB #01 STZ !publish
@east #00 LDZ #0f EQU ?publish #00 LDZ INC #00 STZ !publish
@south #01 LDZ #0b EQU ?publish #01 LDZ INC #01 STZ !publish
@west #00 LDZ #00 EQU ?publish #00 LDZ #01 SUB #00 STZ
@publish
	#00 LDZ #0400 STA #01 LDZ #0401 STA
	#01 #d9 DEO #d9 DEI ?done
	#01 #02 STZ
@done BRK
